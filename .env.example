# ==============================================================================
# Legal AI — Environment Configuration Template
# Copy this file to .env and insert your API keys.
# ==============================================================================

# ── Primary LLM Provider ──────────────────────────────────────────────────────
# Options: "groq", "gemini", "openrouter", "mock" (offline engine)
LLM_PROVIDER=groq

# ── API Keys ──────────────────────────────────────────────────────────────────
# Set the key for your active provider:
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Groq Configuration (Default Free Tier) ────────────────────────────────────
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_GENERATOR_MODEL=openai/gpt-oss-120b
# Verifier MUST be a different model family from generator (Qwen/Alibaba vs OpenAI)
GROQ_VERIFIER_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=6000

# ── Gemini Configuration ──────────────────────────────────────────────────────
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_GENERATOR_MODEL=gemini-3.5-flash
GEMINI_VERIFIER_MODEL=gemma-4-31b-it
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_RPM_LIMIT=15
GEMINI_TPM_LIMIT=1000000

# ── OpenRouter Configuration ──────────────────────────────────────────────────
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# openrouter/free automatically routes to zero-cost models with tool/JSON support
OPENROUTER_GENERATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_VERIFIER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FAST_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_RPM_LIMIT=20
OPENROUTER_TPM_LIMIT=50000

# ── Whisper Speech-to-Text (Groq endpoint) ────────────────────────────────────
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3

# ── Retrieval & Indexing ──────────────────────────────────────────────────────
RETRIEVAL_K=6
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
# Calibrated on empirical evaluation data: in-scope >= 0.0155, out-of-scope <= 0.0105
RETRIEVAL_GATE_THRESHOLD=0.70
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Legal & Guardrail Configuration ───────────────────────────────────────────
AS_OF_DATE=2026-11-01
ALLOW_UNVERIFIED=0
CLAIM_THRESHOLD=1000000
RUN_LOG_PATH=run_log.jsonl
